{
  "name": "simlauncher",
  "version": "1.2.0",
  "description": "SimLauncher - Multi app launcher for simracing",
  "main": "out/main/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stashpeak/SimLauncher.git"
  },
  "bugs": {
    "url": "https://github.com/Stashpeak/SimLauncher/issues"
  },
  "homepage": "https://simlauncher.com/",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run",
    "build": "electron-vite build",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:win:unsigned": "npm run build && electron-builder --win --publish never --config electron-builder.unsigned.yml",
    "lint": "eslint .",
    "preload:types": "node scripts/generate-preload-types.mjs",
    "preload:types:check": "node scripts/generate-preload-types.mjs --check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck:tsc && npm run typecheck:node && npm run preload:types:check",
    "typecheck:tsc": "tsc -p tsconfig.json --noEmit",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "preview": "electron-vite preview",
    "prepare": "git config core.hooksPath .githooks"
  },
  "keywords": [
    "simracing",
    "launcher",
    "electron",
    "react",
    "typescript",
    "windows",
    "sim-racing"
  ],
  "author": "Stashpeak",
  "license": "GPL-3.0-only",
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "react": "^19.2.8",
    "react-colorful": "^5.8.0",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "8.2.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@electron/asar": "4.2.0",
    "js-yaml": "^4.3.1",
    "fast-uri": "^3.1.7",
    "esbuild": "^0.28.1",
    "form-data": "4.0.6",
    "tar": "7.5.22",
    "@babel/core": "7.29.7",
    "postcss": "^8.5.23",
    "brace-expansion": "^5.0.9"
  }
}
